# Placeholders for the run settings of scripts/full/run.sh (docs/setup-guide.md, "Machine-specific settings").
# Copy to local.env (untracked, listed in .gitignore), uncomment the lines you need and fill them in.
# No script reads local.env: load it by hand in the shell that runs a script, with
#   set -a; . ./local.env; set +a
# Every line is commented out, so loading this file unchanged sets nothing and the defaults stay in force.

# Run directory: logs, run records, the clone and the run trees. Default: $HOME/kisscrit-run
# KISSCRIT_RUN_HOME=<path-to-run-directory>

# Where setup installs Miniforge. Default: $HOME/miniforge3
# KISSCRIT_MINIFORGE=<path-to-miniforge>

# The preflight script. Default: found next to run.sh, in the source tree's scripts/full/, or in ~
# KISSCRIT_PREFLIGHT=<path-to>/kisscrit-preflight.sh

# Clone with plain git from this URL instead of `gh repo clone`. Default: unset (--repo-url wins if given)
# KISSCRIT_REPO_URL=<git-url>
